# ---------- Relay (relay/config.py) ----------
# Shared secret between hook and relay. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_API_KEY=change-me-to-a-long-random-string
# Public HTTPS base URL of the relay, used in the phone's Approve/Deny button URLs.
PUBLIC_URL=https://your-relay.example.com

NTFY_SERVER=https://ntfy.sh
# Treat the topic like a password. Generate: python -c "import secrets; print('cc-' + secrets.token_urlsafe(24))"
NTFY_TOPIC=change-me-to-a-long-random-topic
# Optional: access token for a protected / self-hosted ntfy topic.
NTFY_TOKEN=

REQUEST_TTL_SECONDS=300
CLEANUP_INTERVAL_SECONDS=30
MAX_POLL_TIMEOUT_SECONDS=60
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Hook (hook/phone_approve.py) ----------
RELAY_URL=https://your-relay.example.com
# RELAY_API_KEY above is shared by the hook.
# Must be less than the hook "timeout" in settings.json (300).
WAIT_SECONDS=240
# Set to 1 for debug logs on stderr.
PHONE_APPROVE_DEBUG=0

# Optional: static ngrok domain used by scripts/start_all.ps1 (leave empty for a random URL).
NGROK_DOMAIN=

# ---------- Phone console (console/phone_console.py) ----------
# Private topic: anyone who knows it can run Claude/commands on your machine.
# Generate: python -c "import secrets; print('cc-console-' + secrets.token_urlsafe(24))"
CONSOLE_TOPIC=cc-console-change-me-long-random
CONSOLE_WORKDIR=C:\Users\you\Desktop
CONSOLE_ALLOW_SHELL=false
CONSOLE_TIMEOUT_SECONDS=900
CONSOLE_PERMISSION_MODE=default
